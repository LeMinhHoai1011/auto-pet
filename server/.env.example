# ── Database ──────────────────────────────────
# SQLite (local, không cần cài thêm)
# DATABASE_URL=sqlite+aiosqlite:///./petfeeder.db

# PostgreSQL (dùng khi triển khai Docker)
# DATABASE_URL=postgresql+asyncpg://petfeeder:changeme123@db:5432/petfeeder

# ── MQTT ──────────────────────────────────────
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USER=mqtt_user
MQTT_PASS=mqtt_pass

# ── Firebase Cloud Messaging ──────────────────
# FCM_CREDENTIALS_PATH=./firebase-credentials.json

# ── App ───────────────────────────────────────
SECRET_KEY=your-secret-key-change-this
DEVICE_ID=device01
